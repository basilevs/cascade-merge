{
  "name": "cascade-merge",
  "version": "0.0.1",
  "description": "Cascade Merge Github Action",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "esbuild src/{main,post}.ts --bundle --platform=node --format=esm --main-fields=module,main --target=node20 --outdir=dist/ --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "prettier --no-error-on-unmatched-pattern --write \"**/*.{ts,yml,yaml}\"",
    "format-check": "prettier --no-error-on-unmatched-pattern --check \"**/*.{ts,yml,yaml,json}\"",
    "lint": "eslint \"**/*.ts\"",
    "lint:fix": "eslint \"**/*.ts\" --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basilevs/cascade-merge.git"
  },
  "keywords": [],
  "author": "Vasili Gulevich",
  "license": "EPL-2.0",
  "bugs": {
    "url": "https://github.com/basilevs/cascade-merge/issues"
  },
  "homepage": "https://github.com/basilevs/cascade-merge#readme",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^28.14.0",
    "eslint-plugin-node": "^11.1.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0"
  }
}
